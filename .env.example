# Необязательные настройки локального распознавания речи.
WHISPER_LANGUAGE=ru
WHISPER_DEVICE=auto

# Публикации: пустые секреты заполняются только в локальном .env.
PUBLISH_TIMEZONE=Europe/Moscow
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL_ID=
# Optional comma-separated chat IDs or usernames; empty disables the allowlist.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_SESSION_PATH=.local/auth/telegram.session
# OAuth Web application: Authorized redirect URI = http://localhost:8765/
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Резервный вариант Desktop app JSON, если ID и Secret выше пусты:
YOUTUBE_CLIENT_SECRETS_PATH=.local/auth/youtube-client.json
YOUTUBE_TOKEN_PATH=.local/auth/youtube-token.json
YOUTUBE_CHANNEL_ID=
# Дзен: вход в браузере. BotFather и внешний планировщик не используются.
# Встроенная генерация обложек Codex не требует ключа API.
# OAuth JSON, токены и Telegram session хранятся в .local/auth/, вне Git.
